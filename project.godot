; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Native RL"
; Path (not uid) on purpose: the uid form pointed at the deleted root prototype main.tscn, which
; rendered NOTHING — exported builds booted to a blank screen (found via the web deploy, #291).
; A path reference can never dangle silently.
run/main_scene="res://examples/launcher.tscn"
config/features=PackedStringArray("4.5")

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_native_rl/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
